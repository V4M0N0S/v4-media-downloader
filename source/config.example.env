# V4 Media Downloader configuration

# Discord webhook for completed download notifications
DISCORD_WEBHOOK_URL=""

# Optional existing yt-dlp cookie file.
# You can also import cookies from the web interface.
YTDLP_COOKIE_FILE="/etc/v4-media-downloader/youtube-cookies.txt"

# Application directories
V4MD_DOWNLOAD_DIR="/var/lib/v4-media-downloader/downloads"
V4MD_THUMB_DIR="/var/lib/v4-media-downloader/thumbnails"
V4MD_WORK_DIR="/var/lib/v4-media-downloader/work"

# Managed cookie location used by the web interface
V4MD_CONFIG_DIR="/etc/v4-media-downloader"
V4MD_COOKIE_FILE="/etc/v4-media-downloader/youtube-cookies.txt"

# Web server
V4MD_HOST="0.0.0.0"
V4MD_PORT="5000"
